# Copy to .env and adjust. Values are compiled into the public bundle: never put secrets in VITE_ variables.
# Commented-out variables are optional and show their default value. See docs/ENVIRONMENT.md.

# Build time (Vite)
# VITE_API=/imapi/
VITE_CASDOOR_URL=http://localhost:8000
VITE_CASDOOR_CLIENT_ID=
# VITE_QUERY_RUNNER_URL=http://localhost:3000
# VITE_SAFE_PARSE_MODE=false
# BASE_URL="/"

# Testing (Gauge end-to-end tests only; unit tests need none of these)
# TEST_USERNAME=
# TEST_PASSWORD=
